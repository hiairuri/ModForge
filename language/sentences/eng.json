  "templates": {
    // The attributive chain: {mods} are the modifiers ("Rare Attack"), {costs} the cost clauses
    // ("energy cost above 2"). English puts the clauses after the noun.
    "pickPhrase": "{mods} {head}",
    "pickPhraseWithCosts": "{mods} {head} with {costs}",
    "pickPhraseCostsOnly": "{head} with {costs}",
    // "按条件数牌"的说法：范围（{where}）+ 条件（{pick}，就是上面那条定语链）。
    // 英文"Rare Attack cards in your hand"；一个维度都没筛时只念范围。
    "countPhrase": "{pick} in {where}",
    "countPhraseAll": "cards in {where}",
    // With filters, {pick} is that chain, which is plural — so the singular/plural pairs
    // use "one of the …" / "N …" forms.
    "pickFilteredAll": "ALL {pick}",
    "pickFilteredAtMost": "up to {count} of the {pick}",
    // "…, your choice" 而不是 "… you choose"：{pick} 已经以费用从句结尾了，
    // 再往后拖一个 "you choose" 会读成"选的是从句"。
    "pickFilteredChosen": "{count} of the {pick}, your choice",
    "pickFilteredChosen1": "one of the {pick}, your choice",
    "pickFilteredRandomN": "{count} random cards from the {pick}",
    "pickFilteredRandom1": "a random one of the {pick}",
    // Cost-clause templates: {kind} (energy cost / star cost), {op} (above…), {amount} (threshold).
    "costClause": "{kind} {op} {amount}",
    "costClauseIsX": "X {kind}",
    // ---- Explicit clause form (used when one dimension has several values, or 3+ dimensions;
    //      the rule lives in PickerWording.UseShortForm) ----
    //
    // One labelled clause per dimension, joined by clauseJoin (", "), values joined by
    // valueJoinParts + valueJoinLast ("Attack, Skill or Power"). English clauses are
    // prepositional phrases that follow the noun, so the outer template is {head} {clauses}.
    "clauseRarity": "of rarity {values}",
    "clauseType": "with type {values}",
    "clauseTag": "with the {values} tag",
    "clauseKeyword": "that have {values}",
    "clauseCardId": "whose name contains {values}",
    "clauseCost": "with {kind} {op} {amount}",
    "clauseCostIsX": "with X {kind}",
    "filterClausePhrase": "{head} {clauses}",
    // "power stacks" is a generic label; the sentence needs the actual status name.
    "sourcePowerStacks": "{power} stacks",

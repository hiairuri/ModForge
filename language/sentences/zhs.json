  "templates": {
    // 筛选短语（多维度）：{mods} 是修饰语串（"稀有攻击"），{costs} 是费用从句串
    //（"能量消耗大于 2"）。中文把费用从句放前面（"…的稀有攻击牌"），
    // 英文放后面（见 eng.json 的同名模板）。
    "pickPhrase": "{mods}{head}",
    "pickPhraseWithCosts": "{costs}的{mods}{head}",
    "pickPhraseCostsOnly": "{costs}的{head}",
    // "按条件数牌"的说法：范围（{where}）+ 条件（{pick}，就是上面那条定语链）。
    // 中文"手牌中的稀有攻击牌数"；一个维度都没筛时只念范围。
    "countPhrase": "{where}中的{pick}数",
    "countPhraseAll": "{where}的牌数",
    // 带筛选时的取法（{pick} 就是上面那条定语链）。
    // 单数那两条只是把 {count} 写成 1，中文没有单复数，读起来更顺。
    "pickFilteredAll": "所有{pick}",
    "pickFilteredAtMost": "至多 {count} 张{pick}",
    "pickFilteredChosen": "选择的 {count} 张{pick}",
    "pickFilteredChosen1": "选择的 1 张{pick}",
    "pickFilteredRandomN": "随机 {count} 张{pick}",
    "pickFilteredRandom1": "随机 1 张{pick}",
    // 两个费用维度的从句零件：{kind}（能量消耗/星辰消耗）、{op}（大于…）、{amount}（阈值）。
    // 从句尾部带一个空格，好让后面的"的"不与数字贴在一起（"大于 2 的稀有攻击牌"）。
    "costClause": "{kind}{op} {amount} ",
    "costClauseIsX": "{kind}为 X ",
    // ---- 显式从句写法（同一维多值、或三个以上维度时用；判据见 PickerWording.UseShortForm）----
    //
    // 每个维度一个带标签词的从句，从句之间用 clauseJoin（"且"），值之间用 valueJoin*（"、"）。
    // 中文的"的"落在从句尾，所以外层只需把从句串接上头名词：{clauses}{head}。
    "clauseRarity": "稀有度为{values}的",
    "clauseType": "类型为{values}的",
    "clauseTag": "带有{values}标签的",
    "clauseKeyword": "带有{values}的",
    "clauseCardId": "名字中带有{values}的",
    // 费用从句在这套写法里自己收尾成一句（末尾补"的"，与其它从句一致）。
    "clauseCost": "{kind}{op} {amount} 的",
    "clauseCostIsX": "{kind}为 X 的",
    "filterClausePhrase": "{clauses}{head}",
    // "状态层数"这个来源在句子里要换成具体状态的名字："力量 层数"。
    "sourcePowerStacks": "{power}层数",
    "damage": "造成 {num} 点伤害。",
    "damageOther": "对{who}造成 {num} 点伤害。",
    "damageCalc": "造成 等于 {source}{plus} 的伤害。",
    "damageOtherCalc": "对{who}造成 等于 {source}{plus} 的伤害。",
    "block": "获得 {num} 点[gold]格挡[/gold]。",
    "blockOther": "使{who}获得 {num} 点[gold]格挡[/gold]。",
    "blockCalc": "获得 等于 {source}{plus} 的[gold]格挡[/gold]。",
    "blockOtherCalc": "使{who}获得 等于 {source}{plus} 的[gold]格挡[/gold]。",
    "draw": "抽 {num} 张牌。",
    "drawOther": "使{who}抽 {num} 张牌。",
    "drawCalc": "抽 等于 {source}{plus} 张牌。",
    "drawOtherCalc": "使{who}抽 等于 {source}{plus} 张牌。",
    "energy": "获得 {num} 点能量。",
    "energyOther": "使{who}获得 {num} 点能量。",
    "energyCalc": "获得 等于 {source}{plus} 的能量。",
    "energyOtherCalc": "使{who}获得 等于 {source}{plus} 的能量。",
    "stars": "获得 {num} 颗星辰。",
    "starsOther": "使{who}获得 {num} 颗星辰。",
    "starsCalc": "获得 等于 {source}{plus} 的星辰。",
    "starsOtherCalc": "使{who}获得 等于 {source}{plus} 的星辰。",
    "heal": "回复 {num} 点生命。",
    "healOther": "为{who}回复 {num} 点生命。",
    "healCalc": "回复 等于 {source}{plus} 的生命。",
    "healOtherCalc": "为{who}回复 等于 {source}{plus} 的生命。",
    "loseHp": "失去 {num} 点生命。",
    "loseHpOther": "使{who}失去 {num} 点生命。",
    "loseHpCalc": "失去 等于 {source}{plus} 的生命。",
    "loseHpOtherCalc": "使{who}失去 等于 {source}{plus} 的生命。",
    "forge": "[gold]铸造[/gold] {num} 点。",
    "forgeOther": "使{who}[gold]铸造[/gold] {num} 点。",
    "forgeCalc": "[gold]铸造[/gold] 等于 {source}{plus} 的点数。",
    "forgeOtherCalc": "使{who}[gold]铸造[/gold] 等于 {source}{plus} 的点数。",
    "gainMaxHp": "提高 {num} 点最大生命。",
    "gainMaxHpOther": "使{who}提高 {num} 点最大生命。",
    "gainMaxHpCalc": "提高 等于 {source}{plus} 的最大生命。",
    "gainMaxHpOtherCalc": "使{who}提高 等于 {source}{plus} 的最大生命。",
    "loseMaxHp": "降低 {num} 点最大生命。",
    "loseMaxHpOther": "使{who}降低 {num} 点最大生命。",
    "loseMaxHpCalc": "降低 等于 {source}{plus} 的最大生命。",
    "loseMaxHpOtherCalc": "使{who}降低 等于 {source}{plus} 的最大生命。",
    "applyPower": "获得 {num} 层{name}。",
    "applyPowerOther": "对{who}施加 {num} 层{name}。",
    "applyPowerCalc": "获得 等于 {source}{plus} 的{name}。",
    "applyPowerOtherCalc": "对{who}施加 等于 {source}{plus} 的{name}。",
    "removePower": "移除{name}。",
    // 作用于别人（含其奥斯提）时要念出"是谁的"：状态挂在目标身上，而句子原来一句都不提对象。
    "removePowerOther": "移除{who}的{name}。",
    "removePowerBuffOther": "移除{who}的所有正面效果。",
    "removePowerDebuffOther": "移除{who}的所有负面效果。",
    // 移除状态：**上一档"类"**的分档说法（不必点状态名）。
    "removePowerBuff": "移除所有正面效果。",
    "removePowerDebuff": "移除所有负面效果。",
    // "部分移除"：层数由三件套给，所以固定值写 {num}（占位符，跟着升级变）、
    // 算出来的念来源。两个分档各成对，与 draw/drawCalc 那种成对写法同一个规矩。
    // "各 N 层"里的"各"是必要的：多目标时是**每个状态各减 N 层**，不是一共减 N 层。
    "removePowerPartial": "移除{name} {num} 层。",

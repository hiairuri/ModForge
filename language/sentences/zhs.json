    "pickAtMost": "{where}中至多 {count} 张牌",
    "pickThisCard": "这张牌",
    "pickNamedCard": "所有{card}",
    // 挑牌那个名词（不带筛选时）。给"张数是算出来的"句子起头用。
    "pickCardNoun": "牌",
    // 定语链上段与段之间的连接（中文直接连成"稀有攻击"、英文要空格）。
    "modJoin": "",
    // 费用从句的零件：{kind} 与 {op} 是词，{amount} 由阈值填。
    "costKindEnergy": "能量消耗",
    "costKindStar": "星辰消耗",
    "costOpAtLeast": "不小于",
    "costOpAtMost": "不大于",
    "costOpGreaterThan": "大于",
    "costOpLessThan": "小于",
    "costOpNotEqual": "不等于",
    // 多个费用条件之间（"能量消耗大于 2 **且**星辰消耗大于 0"）。
    "costJoin": "且",
    // 定语链上的**修饰语**（{mods} 的那几段）。与 filter* 那组**分开**：那组是名词短语
    //（"攻击牌"），这组是定语（"攻击"）——中文里"稀有攻击牌"读得通、"攻击稀有牌"读不通。
    "modTypeAttack": "攻击",

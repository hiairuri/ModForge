    "modTagMinion": "仆从",
    "modTagOstyAttack": "奥斯提攻击",
    // 关键词：存**裸词**。紧凑写法靠 modKeywordCompact 套上「」才读得通，
    // 显式从句拼成「带有消耗、保留的」——两套句式共用这一个值，不会各有一份写法。
    "modKeywordExhaust": "消耗",
    "modKeywordEthereal": "虚无",
    "modKeywordInnate": "固有",
    "modKeywordRetain": "保留",
    "modKeywordSly": "奇巧",
    "modKeywordUnplayable": "不能被打出",
    "modKeywordEternal": "永恒",
    // 关键词在紧凑写法里的包装："带「消耗」的"。裸词直接接名词会被读成别的意思
    //（"消耗牌"像"会消耗的牌"）。
    "modKeywordCompact": "带「{value}」的",
    // 同一个维度里的多个取值是"或"，中文用顿号（"攻击、技能、能力"）。
    // 与 modJoin（维度**之间**，中文空串）是两件事——早先错用成同一个，值就粘成一坨了。
    "valueJoinParts": "、",
    "valueJoinLast": "、",
    // 显式从句**之间**的连接词（"类型为攻击的**且**带有消耗的"）。
    "clauseJoin": "且",

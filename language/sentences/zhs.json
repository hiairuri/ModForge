    // 复数是"每 N 张"那句要的（英文必须变复数，中文不变，所以中文两套同字）。
    "playedCardsAny": "牌",
    "playedCardsTagStrike": "打击牌",
    "playedCardsTagDefend": "防御牌",
    "playedCardsTagShiv": "小刀",
